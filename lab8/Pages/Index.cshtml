@page
@model lab8.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management - Week 8";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4>Class Management - Week 8</h4>
        </div>
        <div class="text-end">
            <span class="me-3">👋 Welcome, @Model.LoggedInUsername</span>
            <form method="get" asp-page="/Logout" class="d-inline">
                <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Sol: Add Class Form -->
        <div class="col-md-4">
            <h4>Add Class</h4>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Class Name</label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span class="text-danger" asp-validation-for="NewClass.ClassName"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Student Count</label>
                    <input asp-for="NewClass.StudentCount" class="form-control" type="number" />
                    <span class="text-danger" asp-validation-for="NewClass.StudentCount"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span class="text-danger" asp-validation-for="NewClass.Description"></span>
                </div>

                <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add Class</button>
            </form>
        </div>

        <!-- Sağ: Tablo ve Export -->
        <div class="col-md-8">
            <h4>Class List</h4>

            <form method="get" class="mb-3 d-flex">
                <input type="text" name="SearchName" value="@Model.SearchName" class="form-control me-2" placeholder="Filter by Class Name..." />
                <button type="submit" class="btn btn-outline-primary">Filter</button>
            </form>

            <form method="post" class="mb-3">
                <div class="mb-2">
                    <label>Select Columns to Export:</label><br />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="ClassName" checked />
                        <label class="form-check-label">Class Name</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="StudentCount" checked />
                        <label class="form-check-label">Student Count</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="Description" checked />
                        <label class="form-check-label">Description</label>
                    </div>
                </div>
                <button type="submit" asp-page-handler="Export" class="btn btn-success">Export to JSON</button>
            </form>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredClasses)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <nav>
                <ul class="pagination">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                        <a class="page-link" href="?SearchName=@Model.SearchName&PageNumber=@(Model.PageNumber - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="?SearchName=@Model.SearchName&PageNumber=@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?SearchName=@Model.SearchName&PageNumber=@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>
